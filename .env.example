# ARIA environment variables. Copy this file to .env and fill in only the keys you use.
# NEVER commit the real .env file.

# Provider API keys
GEMINI_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Hosted Kokoro speech
HF_TOKEN=

# LifeOS
LIFEOS_API_KEY=

# Optional ARIA_* runtime overrides
# ARIA_PROVIDER=ollama
# ARIA_MODEL=gemma2:9b
# ARIA_SPEECH_ENABLED=true
# ARIA_SPEECH_ENGINE=kokoro_local
# ARIA_CODER_MAX_ITERATIONS=100
# ARIA_CODER_MAX_OUTPUT_CHARS=20000
# ARIA_WORKSPACE=/path/to/project
# ARIA_COMMAND_TIMEOUT_SECONDS=30
# ARIA_MAX_COMMAND_OUTPUT_CHARS=12000
# ARIA_LOG_DIR=data/logs
