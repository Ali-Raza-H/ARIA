# ARIA environment variables. Copy this file to .env and fill in only the keys you use.
# NEVER commit the real .env file.

# Provider API keys (keep ARIA and coder credentials separate)
ARIA_CEREBRAS_API_KEY=
CODER_CEREBRAS_API_KEY=
ARIA_GROQ_API_KEY=
CODER_GROQ_API_KEY=
ARIA_GEMINI_API_KEY=
CODER_GEMINI_API_KEY=
ARIA_MISTRAL_API_KEY=
CODER_MISTRAL_API_KEY=
ARIA_NVIDIA_API_KEY=
CODER_NVIDIA_API_KEY=
ARIA_OPENROUTER_API_KEY=
CODER_OPENROUTER_API_KEY=
ARIA_OPENAI_API_KEY=
CODER_OPENAI_API_KEY=
ARIA_ZAI_API_KEY=
CODER_ZAI_API_KEY=
CODER_OPENAI_API_KEY=

# Google official Gmail MCP and direct Gmail API fallback OAuth access tokens.
# Configure OAuth in Google Cloud; never commit real tokens. The token file
# configured in Gmail may be used instead for local desktop deployments.
GMAIL_MCP_ACCESS_TOKEN=
GMAIL_API_ACCESS_TOKEN=
# Optional OAuth client values if you build a local browser OAuth helper.
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=

# Hosted Kokoro speech
HF_TOKEN=

# Optional remote memory embeddings (Ollama fallbacks are used when unset/unavailable)
MEMORY_EMBEDDING_API_KEY=

# LifeOS
LIFEOS_API_KEY=

# Optional dedicated background/vision provider key names. These are only used
# when background.api_key_env or vision.fallback_api_key_env names them.
# BACKGROUND_PROVIDER_API_KEY=
# VISION_PROVIDER_API_KEY=

# Telemetry is configured in YAML; these optional runtime overrides are useful
# for deployments that need to disable persistence or live UI events.
# ARIA_TELEMETRY_ENABLED=false
# ARIA_TELEMETRY_LIVE=true
# ARIA_TELEMETRY_RETENTION_DAYS=30

# Optional ARIA_* runtime overrides
# ARIA_PROVIDER=ollama
# ARIA_MODEL=gemma2:9b
# ARIA_SPEECH_ENABLED=true
# ARIA_SPEECH_ENGINE=kokoro_local
# ARIA_CODER_MAX_ITERATIONS=100
# ARIA_CODER_MAX_OUTPUT_CHARS=20000
# ARIA_WORKSPACE=/path/to/project
# ARIA_COMMAND_TIMEOUT_SECONDS=30
# ARIA_MAX_COMMAND_OUTPUT_CHARS=12000
# ARIA_LOG_DIR=data/logs
# ARIA_UI_BACKEND=urwid
# ARIA_UI_SHOW_COT=true
# ARIA_UI_KEEP_COT=false
# ARIA_CODER_PROVIDER=ollama
# ARIA_CODER_MODEL=qwen2.5-coder:7b
# ARIA_LIFEOS_BASE_URL=http://127.0.0.1:5000
# ARIA_MEMORY_ENABLED=true
